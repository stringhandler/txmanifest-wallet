fn sphincs_restore_wots_tw_signature(el: u128, ctx: (u8, u8), inv: (u128, u32, u256, u32, u32, u64, u32)) -> (u128, (u8, u8)) {
    let (idx, checksum): (u8, u8) = ctx;
    let (message_hash, key_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2, wots_type): (u128, u32, u256, u32, u32, u64, u32) = inv;

    let (n1, n2, n3, n4): (u2, u2, u2, u2) = <u8>::into(get_byte_at_128(message_hash, jet::divide_8(idx, 4)));
    let idx_mod: u8 = jet::modulo_8(idx, 4);

    let n: u2 = match jet::eq_8(idx_mod, 0) {
        true => n1,
        false => {
            match jet::eq_8(idx_mod, 1) {
                true => n2,
                false => {
                    match jet::eq_8(idx_mod, 2) {
                        true => n3,
                        false => n4,
                    }
                }
            }
        }
    };

    let (_, s_n): (bool, u8) = jet::subtract_8(3, <(u4, (u2, u2))>::into((0, (0, n))));
    let (_, (_, s_n)): (u4, (u2, u2)) = <u8>::into(s_n);
    let (_, checksum): (bool, u8) = jet::add_8(checksum, <(u4, (u2, u2))>::into((0, (0, n))));

    (unwrap_left::<u128>(for_while::<sphincs_wots_tw_hash_n_times_iter>(el, (s_n, <(u16, (u8, u8))>::into((0, (0, idx))), key_idx, midstate, n, layer_adrs, tree_adrs_1, tree_adrs_2, wots_type))), (wrapping_add_8(idx, 1), checksum))
}

