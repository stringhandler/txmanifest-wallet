fn sphincs_hash_leaf_xmss(public_key: SPHINCSWOTSTWKey, ctx: (u32, u256, u32, u32, u64, u32)) -> u128 {
    let (key_index, midstate, layer_adrs, tree_adrs_1, tree_adrs_2, pk_type): (u32, u256, u32, u32, u64, u32) = ctx;

