}

fn sphincs_hash_node_xmss(left: u128, right: u128, ctx: (u32, u32, u256, u32, u32, u64)) -> u128 {
    let (height, node_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2): (u32, u32, u256, u32, u32, u64) = ctx;

    truncate_128(sha256_finish(jet::sha_256_block(midstate, adrs_256(layer_adrs, tree_adrs_1, tree_adrs_2, 12, 0, height, node_idx), <(u128, u128)>::into((left, right))), 1024))
}

fn sphincs_xmss_root_from_path_iter(el: u128, ctx: (u128, u32, u32, u256, u32, u32, u64)) -> (u128, u32, u32, u256, u32, u32, u64) {
    let (current_hash, height, key_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2): (u128, u32, u32, u256, u32, u32, u64) = ctx;

    let (new_key_idx, rem): (u32, u32) = jet::div_mod_32(key_idx, 2);
    let (left, right): (u128, u128) = match jet::eq_32(rem, 0) {
        true => (current_hash, el),
        false => (el, current_hash),
    };

    let (_, new_height): (bool, u32) = jet::add_32(height, 1);
    (sphincs_hash_node_xmss(left, right, (height, new_key_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2)), new_height, new_key_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2)
}

fn sphincs_get_xmss_pub_key(signature: XMSSSignature, pk_seed: u128, message: u128, key_index: u32, midstate: u256, layer_adrs: u32, tree_adrs_1: u32, tree_adrs_2: u64) -> u128 {
    let (signature, merkle_path): XMSSSignature = signature;
    let (_, counter, message_signature): SPHINCSWOTSTWSignature = signature;

    let (message, _): (u128, u128) = <u256>::into(sha256_finish_4(jet::sha_256_block(jet::sha_256_iv(), adrs_256(layer_adrs, tree_adrs_1, tree_adrs_2, 13, key_index, 0, 0), <(u128, u128)>::into((pk_seed, message))), counter, 544));

    let (pk, (_, checksum)): ([u128; 64], (u8, u8)) = sphincs_restore_wots_tw_signature_map_arr_64(message_signature, (0, 0), (message, key_index, midstate, layer_adrs, tree_adrs_1, tree_adrs_2, 10));
    assert!(jet::eq_8(checksum, 140));

    xmss_path_root(array_fold::<sphincs_xmss_root_from_path_iter, 12>(merkle_path, (sphincs_hash_leaf_xmss(pk, (key_index, midstate, layer_adrs, tree_adrs_1, tree_adrs_2, 11)), 1, key_index, midstate, layer_adrs, tree_adrs_1, tree_adrs_2)))
}

fn sphincs_fors_root_from_path_iter(el: u128, ctx: (u128, u256, u32, u32, u32, u64, u32)) -> (u128, u256, u32, u32, u32, u64, u32) {
    let (node, midstate, key_idx, tree_idx, tree_adrs_1, tree_adrs_2, height): (u128, u256, u32, u32, u32, u64, u32) = ctx;

    let (tree_idx, rem): (u32, u32) = jet::div_mod_32(tree_idx, 2);
    let (left, right): (u128, u128) = match jet::eq_32(rem, 0) {
        true => (node, el),
        false => (el, node),
    };

    let (node, _): (u128, u128) = <u256>::into(sha256_finish(jet::sha_256_block(midstate, adrs_256(0, tree_adrs_1, tree_adrs_2, 7, key_idx, height, tree_idx), <(u128, u128)>::into((left, right))), 1024));

    let (_, height): (bool, u32) = jet::add_32(height, 1);
    (node, midstate, key_idx, tree_idx, tree_adrs_1, tree_adrs_2, height)
}

fn get_22_bits_at(message: u256, idx: u8) -> u32 {
    assert!(jet::lt_8(idx, 6));
    let (_, shift): (u8, u8) = <u16>::into(jet::multiply_8(idx, 22));
    let (_, shift): (bool, u8) = jet::subtract_8(234, shift);
    let shifted_msg: u256 = right_shift_256(message, shift);
    let (_, (_, (_, shifted_msg))): (u128, (u64, (u32, u32))) = <u256>::into(shifted_msg);
    jet::and_32(shifted_msg, 0x003FFFFF)
}




fn sphincs_fors_root_from_path(part: SPHINCSFORSSignaturePart, ctx: u8, inv: (u256, u256, u32, u64)) -> (u128, u8) {
    let idx_idx: u8 = ctx;
    let (midstate, message, tree_adrs_1, tree_adrs_2): (u256, u256, u32, u64) = inv;
    let (sk_value, path): SPHINCSFORSSignaturePart = part;

    let key_idx: u32 = get_22_bits_at(message, idx_idx);
    let idx_idx_32: u32 = <(u16, (u8, u8))>::into((0, (0, idx_idx)));

    let (root, _, _, _, _, _, _): (u128, u256, u32, u32, u32, u64, u32) = array_fold::<sphincs_fors_root_from_path_iter, 22>(path, (truncate_128(jet::sha_256_block(midstate, adrs_256(0, tree_adrs_1, tree_adrs_2, 6, idx_idx_32, 0, key_idx), sha256_tail_16(sk_value, 896))), midstate, idx_idx_32, key_idx, tree_adrs_1, tree_adrs_2, 1));

    (root, wrapping_add_8(idx_idx, 1))
}

fn sphincs_fors_root_from_path_map_arr_1 (arr: [SPHINCSFORSSignaturePart; 1], ctx: u8, inv: (u256, u256, u32, u64)) -> ([u128; 1], u8) { let (res, ctx): (u128, u8) = sphincs_fors_root_from_path(<[SPHINCSFORSSignaturePart; 1]>::into(arr), ctx, inv); ([res], ctx) }
fn sphincs_fors_root_from_path_map_arr_2 (arr: [SPHINCSFORSSignaturePart; 2], ctx: u8, inv: (u256, u256, u32, u64)) -> ([u128; 2], u8) { let (arr1, arr2): ([SPHINCSFORSSignaturePart; 1], [SPHINCSFORSSignaturePart; 1]) = <[SPHINCSFORSSignaturePart; 2]>::into(arr); let (res1, ctx): ([u128; 1], u8) = sphincs_fors_root_from_path_map_arr_1 (arr1, ctx, inv); let (res2, ctx): ([u128; 1], u8) = sphincs_fors_root_from_path_map_arr_1 (arr2, ctx, inv); (<([u128; 1], [u128; 1])>::into((res1, res2)), ctx) }
fn sphincs_fors_root_from_path_map_arr_4 (arr: [SPHINCSFORSSignaturePart; 4], ctx: u8, inv: (u256, u256, u32, u64)) -> ([u128; 4], u8) { let (arr1, arr2): ([SPHINCSFORSSignaturePart; 2], [SPHINCSFORSSignaturePart; 2]) = <[SPHINCSFORSSignaturePart; 4]>::into(arr); let (res1, ctx): ([u128; 2], u8) = sphincs_fors_root_from_path_map_arr_2 (arr1, ctx, inv); let (res2, ctx): ([u128; 2], u8) = sphincs_fors_root_from_path_map_arr_2 (arr2, ctx, inv); (<([u128; 2], [u128; 2])>::into((res1, res2)), ctx) }

fn sphincs_get_fors_pub_key(signature: SPHINCSFORSSignature, midstate: u256, message: u256, tree_adrs_1: u32, tree_adrs_2: u64) -> u128 {
    let (_, (parts_4, parts_1)): SPHINCSFORSSignature = signature;

    assert!(jet::eq_32(get_22_bits_at(message, 5), 0));

    let ([root_0, root_1, root_2, root_3], _): ([u128; 4], u8) = sphincs_fors_root_from_path_map_arr_4(parts_4, 0, (midstate, message, tree_adrs_1, tree_adrs_2));
    let ([el], _): ([u128; 1], u8) = sphincs_fors_root_from_path_map_arr_1(parts_1, 4, (midstate, message, tree_adrs_1, tree_adrs_2));

    truncate_128(jet::sha_256_block(jet::sha_256_block(midstate, adrs_256(0, tree_adrs_1, tree_adrs_2, 8, 0, 0, 0), <(u128, u128)>::into((root_0, root_1))), <(u128, u128)>::into((root_2, root_3)), sha256_tail_16(el, 1408)))
}









fn sphincs_root_from_path_iter(el: XMSSSignature, ctx: (u128, u128, u32, u256, u32, u64, u32)) -> (u128, u128, u32, u256, u32, u64, u32) {
    let (pk_seed, message, key_index, midstate, layer_adrs, tree_adrs_2, idx): (u128, u128, u32, u256, u32, u64, u32) = ctx;
    let pub_key: u128 = sphincs_get_xmss_pub_key(el, pk_seed, message, key_index, midstate, layer_adrs, 0, tree_adrs_2);

    let key_index: u32 = idx;
    let idx: u32 = jet::right_shift_32(12, idx);
    let tree_adrs: u64 = <(u32, u32)>::into((0, jet::and_32(idx, 0x00000FFF)));

    let (_, layer_adrs): (bool, u32) = jet::add_32(layer_adrs, 1);

    (pk_seed, pub_key, key_index, midstate, layer_adrs, tree_adrs, idx)
}

fn ht_verify(signature: XMSSHTSignature, pk_seed: u128, message: u128, midstate: u256, tree_adrs_2: u64, leaf_idx: u32, idx: u32) -> u128 {
    let (_, root, _, _, _, _, _): (u128, u128, u32, u256, u32, u64, u32) = array_fold::<sphincs_root_from_path_iter, 2>(signature, (pk_seed, message, leaf_idx, midstate, 0, tree_adrs_2, idx));
    root
}

fn sphincs_verify(proof: SPHINCSSignProof, midstate: u256) -> u128 {
    let (message_hash, pk, signature): SPHINCSSignProof = proof;
    let (pk_seed, pk_root): SPHINCSPK = pk;
    let (fors_signature, xmss_ht_signature): SPHINCSSignature = signature;
    let (r, _): SPHINCSFORSSignature = fors_signature;

    let message: u256 = sha256_finish(jet::sha_256_block(jet::sha_256_block(jet::sha_256_iv(), adrs_256(0, 0, 0, 14, 0, 0, 0), r), <(u128, u128)>::into((pk_seed, pk_root)), message_hash), 1024);

    let (_, ((leaf_part, _), _)): (u128, ((u32, u32), u64)) = <u256>::into(message);
    let idx: u32 = jet::right_shift_32(8, jet::left_shift_32(4, leaf_part));
    let leaf_adrs: u32 = jet::and_32(idx, 0x00000FFF);
    let idx: u32 = jet::right_shift_32(12, idx);

    let (_, tree_adrs_2): (bool, u64) = jet::add_64(jet::multiply_32(idx, jet::left_shift_32(12, 1)), <(u32, u32)>::into((0, leaf_adrs)));
    let fors_pk: u128 = sphincs_get_fors_pub_key(fors_signature, midstate, message, 0, tree_adrs_2);

    ht_verify(xmss_ht_signature, pk_seed, fors_pk, midstate, <(u32, u32)>::into((0, idx)), leaf_adrs, idx)
}

fn shrincs_get_root_from_path_iter(el: u128, ctx: (u128, bool, u256, u32)) -> (u128, bool, u256, u32) {
    let (node, is_right_child, midstate, tree_height): (u128, bool, u256, u32) = ctx;

    let (left, right): (u128, u128) = match is_right_child {
        true => (el, node),
        false => (node, el),
    };

    let (hash, _): (u128, u128) = <u256>::into(sha256_finish(jet::sha_256_block(midstate, adrs_256(0, 0, 0, 2, 0, tree_height, 0), <(u128, u128)>::into((left, right))), 1024));

    let (_, tree_height): (bool, u32) = jet::add_32(tree_height, 1);

    (hash, true, midstate, tree_height)
}

fn restore_uxmss_signature(proof: UXMSSSignProof, midstate: u256) -> u128 {
    let (message, pk, signature): UXMSSSignProof = proof;
    let (pk_seed, root): SPHINCSPK = pk;
    let (wots_signature, merkle_path, key_idx): UXMSSSignature = signature;
    let (r, counter, message_signature): SPHINCSWOTSTWSignature = wots_signature;

    let (message, _): (u128, u128) = <u256>::into(sha256_finish(jet::sha_256_block(jet::sha_256_block(jet::sha_256_iv(), adrs_256(0, 0, 0, 4, 0, 0, 0), r), <(u128, u128)>::into((pk_seed, root)), message), 1024));

    let (message, _): (u128, u128) = <u256>::into(sha256_finish_4(jet::sha_256_block(jet::sha_256_iv(), adrs_256(0, 0, 0, 3, key_idx, 0, 0), <(u128, u128)>::into((pk_seed, message))), counter, 544));

    let (pk, (_, checksum)): ([u128; 64], (u8, u8)) = sphincs_restore_wots_tw_signature_map_arr_64(message_signature, (0, 0), (message, key_idx, midstate, 0, 0, 0, 0));
    assert!(jet::eq_8(checksum, 140));


    let (_, tree_height): (bool, u32) = match jet::eq_32(key_idx, 207) {
        true => (false, 1),
        false => jet::subtract_32(207, key_idx),
    };

    uxmss_path_root(fold::<shrincs_get_root_from_path_iter, 512>(merkle_path, (sphincs_hash_leaf_xmss(pk, (key_idx, midstate, 0, 0, 0, 1)), jet::eq_32(key_idx, 207), midstate, tree_height)))
}

fn shrincs_verify(proof: SHRINCSSignProof) {
    let (message, seed_root, signature, root_part): SHRINCSSignProof = proof;
    let (public_parameter, expected_root): SPHINCSPK = seed_root;

    let midstate: u256 = jet::sha_256_block(jet::sha_256_iv(), <(u128, u128)>::into((public_parameter, 0)), 0);

    let roots: u256 = match signature {
        Left(uxmss: UXMSSSignature) => {
            <(u128, u128)>::into((restore_uxmss_signature((message, seed_root, uxmss), midstate), root_part))
        },
        Right(sphincs: SPHINCSSignature) => {
            <(u128, u128)>::into((root_part, sphincs_verify((message, seed_root, sphincs), midstate)))
        },
    };

    let (root, _): (u128, u128) = <u256>::into(sha256_finish(jet::sha_256_block(midstate, adrs_256(0, 0, 0, 16, 0, 0, 0), roots), 1024));

    assert!(eq_128(root, expected_root));
}

fn main() {
    let pk: SPHINCSPK = <u256>::into(param::PK);
    let sig: Either<UXMSSSignature, SPHINCSSignature> = witness::SIG;
    let other_root: u128 = witness::OTHER_ROOT;
    shrincs_verify((jet::sig_all_hash(), pk, sig, other_root));
}
