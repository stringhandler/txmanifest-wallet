{
  "$schema": "https://raw.githubusercontent.com/stringhandler/txmanifest-wallet/main/schema/txmanifest.schema.json",
  "manifest_version": "0.3.1",
  "protocol": "shrincs-smoke-test",
  "description": "SMOKE TEST ONLY. Locks coins to upstream's SHRINCS verifier, unmodified, and spends them with upstream's own stateful witness. The verifier takes the public key and the message as witness data, so this coin is anyone-can-spend: it shows the Simplicity signet runs a SHRINCS verification, not that the coin is protected by one.",
  "chain": "bitcoin",
  "requires": [
    "simplicity"
  ],
  "simplicity_hl": {
    "version": "0.7.1",
    "debug_symbols": false
  },
  "utxo_types": {
    "shrincs_unbound": {
      "description": "Upstream's SHRINCS verifier with nothing pinned. Anyone holding a valid SHRINCS signature for any key and any message can spend it.",
      "script": {
        "type": "simplicity",
        "source": "./shrincs_main.simf",
        "source_hash": "sha256:710146ef52609c4be82a95a08dcc8827257e2a6b38e817c21d55c4b6aa2aff3a"
      }
    }
  },
  "actions": {
    "Lock": {
      "description": "Send coins to the unbound SHRINCS verifier.",
      "intent": "Lock {params.amount_sat} sat under the SHRINCS smoke-test verifier",
      "allow_change": "lbtc_only",
      "params": {
        "amount_sat": {
          "type": "u64",
          "description": "Amount to lock. Keep it small: anyone can spend it.",
          "default": "20000"
        }
      },
      "inputs": [
        {
          "id": "funding",
          "utxo_source": "wallet",
          "asset": "lbtc",
          "amount_sat": {
            "min_amount": "params.amount_sat"
          },
          "ui": {
            "label": "coin being locked",
            "role": "funding"
          }
        }
      ],
      "outputs": [
        {
          "id": "vault",
          "amount_sat": "params.amount_sat",
          "asset": "lbtc",
          "destination": {
            "utxo_type": "shrincs_unbound"
          },
          "ui": {
            "label": "coins locked under the verifier",
            "role": "covenant"
          }
        }
      ]
    },
    "Spend": {
      "description": "Spend the coin with upstream's stateful SHRINCS witness (q=1, message 0).",
      "intent": "Spend the SHRINCS smoke-test coin back to this wallet",
            "inputs": [
        {
          "id": "vault_in",
          "utxo_source": {
            "utxo_type": "shrincs_unbound"
          },
          "witnesses": {
