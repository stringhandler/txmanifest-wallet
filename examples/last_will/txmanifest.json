{
    "$schema": "../../schema/txmanifest.schema.json",
    "manifest_version": "0.3.0",
    "protocol": "last-will",
    "$comment": "Last Will — a recursive covenant with three spending paths: inherit (after a 180-day timelock), cold-key break-out, and hot-key refresh. Modelled as a class: one instance per will.",
    "chain": "liquid",
    "utxo_types": {
        "last_will": {
            "$comment": "Funds locked under the last-will covenant.",
            "script": {
                "type": "simplicity",
                "source": "./last_will.simf",
                "compile_params": {
                    "INHERITOR_PUB_KEY": "inheritor_pub_key",
                    "HOT_PUB_KEY": "hot_pub_key",
                    "COLD_PUB_KEY": "cold_pub_key",
                    "INHERIT_BLOCKS": "inherit_blocks"
                }
            },
            "asset": "lbtc"
        }
    },
    "contract_templates": {
        "last_will_contract": {
            "$comment": "A last-will covenant. One instance per will: created by Fund, then spent via ColdBreak, Refresh, or Inherit.",
            "fields": {
                "inheritor_pub_key": {
                    "type": "pubkey"
                },
                "hot_pub_key": {
                    "type": "pubkey"
                },
                "cold_pub_key": {
                    "type": "pubkey"
                },
                "inherit_blocks": {
                    "type": "u16"
                }
            },
            "actions": {
                "Fund": {
                    "$comment": "Set up the will: lock funds into the covenant and write the instance file recording the three keys.",
                    "params": {
                        "inheritor_pub_key": {
                            "type": "pubkey",
                            "ui_help": "The heir's x-only public key. They can claim the funds 180 days after the last move."
                        },
                        "hot_pub_key": {
                            "type": "pubkey",
                            "ui_help": "Owner's hot key. Auto-filled from your wallet signing key."
                        },
                        "cold_pub_key": {
                            "type": "pubkey",
                            "ui_help": "Owner's cold key. Your wallet's oracle key — the covenant escape hatch."
                        },
                        "inherit_blocks": {
                            "type": "u16",
                            "default": "25920",
                            "ui_help": "Blocks of inactivity before the heir may claim. ~180 days ≈ 25920 (1-minute Liquid blocks). Max 65535."
                        },
                        "amount_sat": {
                            "type": "u64",
                            "ui_help": "Amount in satoshis to place under the will."
                        }
                    },
                    "inputs": [
                        {
                            "id": "funding_input",
                            "$comment": "Wallet UTXO providing the funds.",
                            "utxo_source": "wallet",
                            "asset": "lbtc",
                            "amount_sat": {
                                "min_amount": "params.amount_sat"
                            }
                        }
                    ],
                    "outputs": [
                        {
                            "id": "will_out",
                            "$comment": "The funded last-will output.",
                            "destination": {
                                "utxo_type": "last_will"
                            },
                            "amount_sat": "params.amount_sat",
                            "asset": "lbtc"
                        },
                        {
                            "id": "change_out",
                            "$comment": "Change returned to the funding wallet.",
                            "destination": "change",
                            "asset": "lbtc",
                            "optional": true
                        }
                    ],
                    "create_instance": {
                        "fields": {
                            "inheritor_pub_key": "$params.inheritor_pub_key",
                            "hot_pub_key": "$params.hot_pub_key",
                            "cold_pub_key": "$params.cold_pub_key",
                            "inherit_blocks": "$params.inherit_blocks"
                        }
                    }
                },
                "ColdBreak": {
                    "$comment": "Owner breaks out of the covenant with the cold key. Funds return to the wallet and the covenant ends.",
                    "inputs": [
                        {
                            "id": "will_in",
                            "$comment": "The last-will covenant UTXO, located via the state file.",
                            "utxo_source": {
                                "utxo_type": "last_will"
                            },
                            "witnesses": {
                                "SPEND_PATH": {
                                    "type": "simplicityhl",
                                    "simplicity_type": "Either<(), Either<(), ()>>",
                                    "value": "Right(Left(()))",
                                    "$comment": "Selects the cold-spend path."
                                },
                                "COLD_SIG": {
                                    "type": "Signature",
                                    "sig_type": "sig_hash_all",
                                    "source": {
                                        "type": "wallet",
                                        "key": "instance.cold_pub_key"
                                    },
                                    "$comment": "BIP340 signature from the cold key."
                                },
                                "HOT_SIG": "unused",
                                "INHERITOR_SIG": "unused"
                            }
                        }
                    ],
                    "outputs": [
                        {
                            "id": "to_wallet",
                            "$comment": "The reclaimed funds, sent to your wallet.",
                            "destination": "wallet",
                            "asset": "lbtc",
                            "amount_sat": "will_in.amount_sat - fee"
                        }
                    ]
                },
                "Refresh": {
                    "$comment": "Owner moves the funds with the hot key, repeating the covenant. Output 0 must be the same last-will covenant; output 1 is the explicit fee.",
                    "inputs": [
                        {
                            "id": "will_in",
                            "$comment": "The last-will covenant UTXO, located via the state file.",
                            "utxo_source": {
                                "utxo_type": "last_will"
                            },
                            "witnesses": {
                                "SPEND_PATH": {
                                    "type": "simplicityhl",
                                    "simplicity_type": "Either<(), Either<(), ()>>",
                                    "value": "Right(Right(()))",
                                    "$comment": "Selects the hot-key refresh path."
                                },
                                "HOT_SIG": {
                                    "type": "Signature",
                                    "sig_type": "sig_hash_all",
                                    "source": {
                                        "type": "wallet",
                                        "key": "instance.hot_pub_key"
                                    },
                                    "$comment": "BIP340 signature from the hot key."
                                },
                                "COLD_SIG": "unused",
                                "INHERITOR_SIG": "unused"
                            }
                        }
                    ],
                    "outputs": [
                        {
                            "id": "will_again",
                            "$comment": "The re-locked last-will output (same covenant address). Must be output 0.",
                            "destination": {
                                "utxo_type": "last_will"
                            },
                            "asset": "lbtc",
                            "amount_sat": "will_in.amount_sat - fee",
                            "required_index": 0
                        }
                    ]
                },
                "Inherit": {
                    "$comment": "The heir claims the funds 180 days after the last move. Requires the inheritor's signature and a relative timelock.",
                    "inputs": [
                        {
                            "id": "will_in",
                            "$comment": "The last-will covenant UTXO, located via the state file.",
                            "utxo_source": {
                                "utxo_type": "last_will"
                            },
                            "sequence": {
                                "relative_blocks": "instance.inherit_blocks"
                            },
                            "witnesses": {
                                "SPEND_PATH": {
                                    "type": "simplicityhl",
                                    "simplicity_type": "Either<(), Either<(), ()>>",
                                    "value": "Left(())",
                                    "$comment": "Selects the inherit path."
                                },
                                "INHERITOR_SIG": {
                                    "type": "Signature",
                                    "sig_type": "sig_hash_all",
                                    "source": {
                                        "type": "wallet",
                                        "key": "instance.inheritor_pub_key"
                                    },
                                    "$comment": "BIP340 signature from the heir's key."
                                },
                                "COLD_SIG": "unused",
                                "HOT_SIG": "unused"
                            }
                        },
                        {
                            "id": "fee_input",
                            "$comment": "Wallet L-BTC UTXO to pay the network fee.",
                            "utxo_source": "wallet",
                            "asset": "lbtc",
                            "optional": true
                        }
                    ],
                    "outputs": [
                        {
                            "id": "to_heir",
                            "$comment": "The inherited funds, sent to the heir's wallet.",
                            "destination": "wallet",
                            "asset": "lbtc",
                            "amount_sat": "will_in.amount_sat"
                        },
                        {
                            "id": "fee_change",
                            "$comment": "L-BTC change from the fee input.",
                            "destination": "change",
                            "asset": "lbtc",
                            "optional": true
                        }
                    ]
                }
            }
        }
    }
}