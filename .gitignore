/target/

/.vscode/
/.claude/

# Wallet & runtime artifacts — never commit keys or local state.
# (Example manifests are named txmanifest.json / params.json and stay tracked.)
wallet*.json
oracle.json
*_wallet.json
# Both the base names and the versioned/history ones the engine writes:
# txmanifest.state.1.json, if.state.history.json, txmanifest.instance.2.json …
*.state.json
*.state.*.json
*.instance.json
*.instance.*.json
meta

# Signed manifests are build products of `tx-manifest-sign`, never sources. The repo
# keeps the unsigned file: a checked-in signature goes stale on the next content edit
# and then reads as an endorsement of text nobody endorsed.
*.signed.json

# Publisher secret keys.
*.key
